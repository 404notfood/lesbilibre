# Configuration locale du script de deploiement `./pull`.
#
# Sur le VPS :
#   cp .pull.env.example .pull.env
#   nano .pull.env
#
# Ce fichier est interprete par Bash. Ne le committez pas apres y avoir ajoute
# des informations propres au serveur.

DEPLOY_REMOTE="origin"
DEPLOY_BRANCH="main"

# Installation PM2 locale au compte, sans sudo.
PM2_BIN="$HOME/.local/bin/pm2"

# Soketi 1.x doit etre execute avec Node 18, independamment du Node recent
# utilise par Vite. Remplacer ces deux chemins par les resultats de :
#   nvm which 18
#   command -v soketi
SOKETI_NODE_BIN="$HOME/.nvm/versions/node/v18.20.8/bin/node"
SOKETI_BIN="$HOME/.nvm/versions/node/v18.20.8/bin/soketi"

# Laisser vide avec Pusher Cloud : il n'y a aucun serveur local a redemarrer.
#
# Soketi gere par PM2 sous votre propre compte : aucun acces sudo/root requis.
# startOrReload le demarre aussi s'il n'est pas encore lance.
WEBSOCKET_RESTART_COMMAND="$PM2_BIN startOrReload ecosystem.config.cjs --only soketi --update-env"
#
# Autres exemples :
# WEBSOCKET_RESTART_COMMAND="systemctl --user restart soketi"
# WEBSOCKET_RESTART_COMMAND="supervisorctl restart soketi"
# WEBSOCKET_RESTART_COMMAND="$PM2_BIN restart soketi"
#
# Laravel Reverb est detecte automatiquement lorsque cette valeur est vide.
# WEBSOCKET_RESTART_COMMAND=""

# Passer a 0 si aucun worker Laravel ne tourne sur le VPS.
RESTART_QUEUE="1"

# Passer a 1 pour supprimer les dependances NPM de developpement apres le build.
# Cela economise de l'espace disque, mais rend le deploiement un peu plus long.
PRUNE_NPM_DEV_DEPENDENCIES="0"
