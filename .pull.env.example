# Configuration locale du script de deploiement `./pull`.
#
# Sur le VPS :
#   cp .pull.env.example .pull.env
#   nano .pull.env
#
# Ce fichier est interprete par Bash. Ne le committez pas apres y avoir ajoute
# des informations propres au serveur.

DEPLOY_REMOTE="origin"
DEPLOY_BRANCH="main"

# Installation PM2 locale au compte, sans sudo.
PM2_BIN="$HOME/.local/bin/pm2"

# Laisser vide avec Pusher Cloud : il n'y a aucun serveur local a redemarrer.
#
# Laravel Reverb gere par PM2 sous votre compte : aucun acces sudo/root requis.
# startOrReload le demarre egalement s'il n'est pas encore lance.
WEBSOCKET_RESTART_COMMAND="$PM2_BIN startOrReload ecosystem.config.cjs --only laravel-reverb --update-env"
#
# Autres exemples :
# WEBSOCKET_RESTART_COMMAND="systemctl --user restart laravel-reverb"
# WEBSOCKET_RESTART_COMMAND="supervisorctl restart laravel-reverb"
# Sans gestionnaire de processus, `reverb:restart` arrete le serveur sans
# garantir son redemarrage ; PM2 reste donc recommande ici.
# WEBSOCKET_RESTART_COMMAND=""

# Passer a 0 si aucun worker Laravel ne tourne sur le VPS.
RESTART_QUEUE="1"

# Passer a 1 pour supprimer les dependances NPM de developpement apres le build.
# Cela economise de l'espace disque, mais rend le deploiement un peu plus long.
PRUNE_NPM_DEV_DEPENDENCIES="0"
