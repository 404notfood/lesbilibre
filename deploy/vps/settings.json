{
  "name": "lesbilibre",
  "type": "laravel-react",
  "domains": [{ "name": "lesbi-libre.fr", "role": "application" }],
  "php": "8.4",
  "node": "24",
  "availablePhp": ["8.4"],
  "availableNode": ["24"],
  "packageManager": "npm",
  "database": "mariadb",
  "redis": true,
  "redisMode": "dedicated",
  "redisMemory": 256,
  "queue": true,
  "queueDriver": "redis",
  "workers": 2,
  "queueTimeout": 600,
  "scheduler": true,
  "https": true,
  "email": "contact@lesbi-libre.fr",
  "ssh": true,
  "sshAuth": "password",
  "source": "present",
  "migrations": true,
  "uploadSize": 100,
  "timeout": 120,
  "phpChildren": 4,
  "requiredEnv": ["REVERB_APP_KEY", "REVERB_APP_SECRET", "MODERATION_API_TOKEN", "VITE_REVERB_APP_KEY"],
  "hexSecretKeys": ["REVERB_APP_KEY", "REVERB_APP_SECRET", "MODERATION_API_TOKEN"],
  "envDefaults": {
    "APP_NAME": "LesbiLibre",
    "APP_LOCALE": "fr",
    "APP_FALLBACK_LOCALE": "fr",
    "SUPPORT_EMAIL": "contact@lesbi-libre.fr",
    "SEO_INDEXING_ENABLED": "false",
    "INERTIA_SSR_ENABLED": "true",
    "SESSION_SECURE_COOKIE": "true",
    "BROADCAST_CONNECTION": "reverb",
    "DB_QUEUE_RETRY_AFTER": "660",
    "REDIS_QUEUE_RETRY_AFTER": "660",
    "MAIL_MAILER": "log",
    "MAIL_FROM_ADDRESS": "contact@lesbi-libre.fr",
    "REVERB_APP_ID": "lesbilibre",
    "REVERB_HOST": "127.0.0.1",
    "REVERB_PORT": "18080",
    "REVERB_SCHEME": "http",
    "REVERB_SERVER_HOST": "127.0.0.1",
    "REVERB_SERVER_PORT": "18080",
    "VITE_REVERB_HOST": "lesbi-libre.fr",
    "VITE_REVERB_PORT": "443",
    "VITE_REVERB_SCHEME": "https",
    "VITE_APP_NAME": "LesbiLibre",
    "MODERATION_SERVICE_URL": "http://127.0.0.1:18000",
    "HUSKY": "0"
  }
}
