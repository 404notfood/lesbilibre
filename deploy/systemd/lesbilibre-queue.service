[Unit]
Description=LesbiLibre Laravel queue worker
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/web/steff.404notfood.fr/public_html/site
ExecStart=/usr/bin/php artisan queue:work --sleep=2 --tries=3 --timeout=300 --max-time=3600
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
