APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

ANTI_ABUSE_REGISTRATION_PER_HOUR=5
ANTI_ABUSE_DUPLICATE_MESSAGE_WINDOW=10
# ANTI_ABUSE_DISPOSABLE_DOMAINS=mailinator.com,tempmail.com

# Local image moderation service (keep this secret private to the Docker network)
MODERATION_SERVICE_URL=http://127.0.0.1:8000
MODERATION_API_TOKEN=
MODERATION_NSFW_QUARANTINE_THRESHOLD=0.85
NSFW_MODEL_ID=Falconsai/nsfw_image_detection

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

STRIPE_KEY=pk_test_your_publishable_key_here
STRIPE_SECRET=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Stripe Price IDs pour les abonnements Premium
STRIPE_PRICE_1_MONTH=price_1month_id_here
STRIPE_PRICE_3_MONTHS=price_3months_id_here
STRIPE_PRICE_6_MONTHS=price_6months_id_here

# Web Push VAPID Keys (generate with: ./vendor/bin/web-push generate-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Programme de parrainage (récompense après vérification manuelle du profil)
REFERRALS_ENABLED=true
REFERRAL_REFERRER_REWARD=150
REFERRAL_REFERRED_REWARD=50

VITE_APP_NAME="${APP_NAME}"

# Soketi / Pusher auto-heberge
# Utiliser BROADCAST_CONNECTION=pusher en production lorsque Soketi est actif.
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
PUSHER_HOST=127.0.0.1
PUSHER_PORT=6001
PUSHER_SCHEME=http

# Variables integrees au bundle navigateur pendant `npm run build`.
# Avec un proxy WebSocket HTTPS sur le domaine courant, seule la cle est requise.
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
# Ne jamais utiliser 127.0.0.1 ici en production : utiliser le domaine public.
# VITE_PUSHER_HOST=ws.example.com
# VITE_PUSHER_PORT=443
# VITE_PUSHER_SCHEME=https
